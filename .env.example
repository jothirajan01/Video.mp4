# AWS Configuration
AWS_REGION=ap-south-1
AWS_S3_BUCKET=my-private-media-bucket

# AWS Credentials (server-side only, never expose in frontend)
# Leave both blank when using an attached IAM role in AWS hosting.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# File Size Limits
MAX_IMAGE_SIZE_MB=100
MAX_VIDEO_SIZE_MB=4096

# Presigned URL expiration (in seconds)
SIGNED_URL_EXPIRATION_SECONDS=300

# Multipart upload threshold (files larger than this use multipart upload)
MULTIPART_UPLOAD_THRESHOLD_MB=100

# Multipart part size (each part will be this size)
MULTIPART_PART_SIZE_MB=10
